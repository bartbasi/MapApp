{
  "name": "mapapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MapApp: a free, open source GPS mapping app for hunters.",
  "license": "SEE LICENSE IN ../LICENSE",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "stage-archives": "node scripts/stage-archives.mjs",
    "android:sync": "npm run build && npm run stage-archives && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/geolocation": "8.2.5",
    "@mapbox/vector-tile": "3.0.0",
    "maplibre-gl": "6.18.0",
    "pbf": "5.1.2",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@maplibre/maplibre-gl-style-spec": "26.6.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
